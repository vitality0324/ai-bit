---
import { NAV_LINKS, SITE, SOCIAL_LINKS } from '../consts';
import { isActive, stripBase, withBase } from '../lib/url';
import Icon from './Icon.astro';

const current = stripBase(Astro.url.pathname);
const links = NAV_LINKS.map((link) => ({
  ...link,
  href: withBase(link.href),
  active: isActive(current, link.href),
}));
---

<header class="site-header" id="site-header">
  <div class="container">
    <nav class="nav" aria-label="主导航">
      <a class="brand" href={withBase('/')} aria-label={`${SITE.title} 首页`}>
        <img
          class="brand__mark"
          src={withBase('/brand/logo-mark.png')}
          alt=""
          width="30"
          height="30"
          aria-hidden="true"
        />
        <span>{SITE.title}</span>
      </a>

      <div class="nav__links" id="nav-links">
        {
          links.map((link) => (
            <a
              class="nav__link"
              href={link.href}
              data-active={link.active ? 'true' : 'false'}
              aria-current={link.active ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="nav__actions">
        <button
          class="icon-btn theme-toggle"
          id="theme-toggle"
          type="button"
          aria-label="切换深色 / 浅色模式"
          title="切换主题"
        >
          <span class="moon"><Icon name="moon" /></span>
          <span class="sun"><Icon name="sun" /></span>
        </button>

        {
          SOCIAL_LINKS.slice(0, 1).map((social) => (
            <a
              class="icon-btn"
              href={social.href}
              aria-label={social.label}
              title={social.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={social.icon} />
            </a>
          ))
        }

        <button
          class="icon-btn nav__toggle"
          id="nav-toggle"
          type="button"
          aria-label="打开菜单"
          aria-expanded="false"
          aria-controls="nav-links"
        >
          <span id="nav-toggle-icon"><Icon name="menu" /></span>
        </button>
      </div>
    </nav>
  </div>
</header>

<script>
  // 滚动时给页头加投影
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // 移动端菜单
  const toggle = document.getElementById('nav-toggle');
  const links = document.getElementById('nav-links');
  const iconWrap = document.getElementById('nav-toggle-icon');
  const menuIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"><path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"/></svg>';
  const closeIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"><path fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" d="M6 6l12 12M18 6 6 18"/></svg>';

  const setOpen = (open: boolean) => {
    links?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (iconWrap) iconWrap.innerHTML = open ? closeIcon : menuIcon;
  };

  toggle?.addEventListener('click', () => {
    setOpen(!links?.classList.contains('is-open'));
  });

  links?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setOpen(false))
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
