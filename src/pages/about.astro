---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE, SOCIAL_LINKS } from '../consts';
import { withBase } from '../lib/url';

const focus = [
  {
    icon: 'sparkles',
    title: 'AI 应用',
    desc: '把大模型能力落到真实的产品里：RAG、Agent、工作流编排与效果评估。',
  },
  {
    icon: 'tag',
    title: '软件工程',
    desc: '在意代码的可维护性、构建效率与交付质量，偏爱简单可靠的方案。',
  },
  {
    icon: 'sparkles',
    title: '产品思考',
    desc: '从用户问题出发，而不是从技术名词出发。写清楚比说得炫更重要。',
  },
] as const;

const timeline = [
  { year: '现在', text: '在一线做 AI 应用与工程实践，持续把踩过的坑写下来。' },
  { year: '过去', text: '做过前后端、基础设施与团队协作工具，喜欢把复杂的事情拆简单。' },
  { year: '一直', text: '保持阅读与写作，相信沉淀会让思考变得更锋利。' },
] as const;
---

<BaseLayout title="关于" description={`关于 ${SITE.author} 与这个站点。`}>
  <section class="section">
    <div class="container container--narrow">
      <header class="about-head fade-in">
        <div class="about-avatar" aria-hidden="true">
          {SITE.author.slice(0, 1).toUpperCase()}
        </div>
        <div class="about-head__text">
          <span class="eyebrow">About</span>
          <h1>你好 👋</h1>
          <p>
            欢迎来到 {SITE.title}。这里是我记录思考的地方——关于 AI、工程与产品的实践笔记，
            有些是完整的总结，有些只是一闪而过的碎片。
          </p>
        </div>
      </header>

      <div class="prose about-prose">
        <h2>这个站点</h2>
        <p>
          这个站点是一个纯静态网站：所有页面在构建时生成，部署后不需要任何服务器，
          打开速度快、维护成本低。文章使用 Markdown 编写，新增一篇只需要在
          <code>src/content/posts/</code> 目录里放一个 <code>.md</code> 文件。
        </p>
        <p>
          我希望它保持简单：没有花哨的追踪脚本，没有复杂的后台，只有干净的排版和舒服的阅读体验。
        </p>

        <h2>我在关注什么</h2>
      </div>

      <div class="focus-grid">
        {
          focus.map((item) => (
            <div class="focus-card">
              <span class="focus-card__icon">
                <Icon name={item.icon} size={18} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="prose about-prose">
        <h2>一点经历</h2>
      </div>

      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class="timeline__item">
              <span class="timeline__year">{item.year}</span>
              <span class="timeline__text">{item.text}</span>
            </li>
          ))
        }
      </ol>

      <div class="prose about-prose">
        <h2>联系我</h2>
        <p>
          如果文章对你有帮助，或者你想聊聊某个话题，欢迎通过下面的方式找到我。
        </p>
      </div>

      <div class="contact-row">
        {
          SOCIAL_LINKS.map((social) => (
            <a
              class="btn btn--ghost"
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel="noopener noreferrer"
            >
              <Icon name={social.icon} size={17} />
              {social.label}
            </a>
          ))
        }
        <a class="btn btn--primary" href={withBase('/posts')}>
          去看看文章
          <Icon name="arrow-right" size={17} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-head {
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .about-avatar {
    display: grid;
    place-items: center;
    width: 5.25rem;
    height: 5.25rem;
    border-radius: 28%;
    font-size: 2.3rem;
    font-weight: 800;
    color: #fff;
    background-image: linear-gradient(135deg, var(--accent), var(--accent-2) 55%, var(--accent-3));
    box-shadow: 0 18px 36px -18px color-mix(in oklab, var(--accent) 90%, transparent);
    flex-shrink: 0;
  }
  :root[data-theme='dark'] .about-avatar {
    color: #0a0b0e;
  }

  .about-head__text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    min-width: 16rem;
  }
  .about-head__text h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.5rem);
    letter-spacing: -0.035em;
  }
  .about-head__text p {
    color: var(--text-muted);
    line-height: 1.8;
  }

  .about-prose {
    font-size: 1.03rem;
  }
  .about-prose h2:first-child {
    margin-top: 0;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 1.75rem 0 2.5rem;
  }

  .focus-card {
    padding: 1.3rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: transform 0.35s var(--ease), border-color 0.3s, box-shadow 0.35s var(--ease);
  }
  .focus-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklab, var(--accent) 42%, var(--border));
    box-shadow: var(--shadow);
  }
  .focus-card__icon {
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 10px;
    color: var(--accent);
    background: var(--accent-soft);
    margin-bottom: 0.85rem;
  }
  .focus-card h3 {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }
  .focus-card p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }
  .timeline__item {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding-left: 1.5rem;
    position: relative;
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .timeline__year {
    font-weight: 700;
    color: var(--accent);
    font-size: 0.9rem;
    min-width: 3rem;
    flex-shrink: 0;
  }
  .timeline__text {
    color: var(--text-muted);
    line-height: 1.75;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
</style>
