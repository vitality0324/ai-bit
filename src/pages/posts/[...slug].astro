---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { SITE } from '../../consts';
import { formatDate, readingTime, sortPosts } from '../../lib/utils';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const visible = posts.filter((p) => import.meta.env.DEV || !p.data.draft);

  return visible.map((post) => ({
    params: { slug: post.id },
    props: { post, all: visible },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  all: CollectionEntry<'posts'>[];
}

const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, cover, author } = post.data;

const ordered = sortPosts(all);
const index = ordered.findIndex((p) => p.id === post.id);
const prev = index > 0 ? ordered[index - 1] : undefined;
const next = index < ordered.length - 1 ? ordered[index + 1] : undefined;

const minutes = readingTime(post.body);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const coverSrc = cover
  ? /^https?:\/\//.test(cover)
    ? cover
    : withBase(cover)
  : undefined;
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={coverSrc}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  tags={tags}
>
  <div class="progress" aria-hidden="true"><span id="progress-bar"></span></div>

  <div class="container container--post">
    <article class="post">
      <header class="post__header fade-in">
        <a class="back-link" href={withBase('/posts')}>
          <Icon name="arrow-left" size={16} />
          返回文章列表
        </a>

        <h1>{title}</h1>

        {description && <p class="post__desc">{description}</p>}

        <div class="post__meta">
          <span class="avatar" aria-hidden="true">
            {(author ?? SITE.author).slice(0, 1).toUpperCase()}
          </span>
          <span class="post__author">{author ?? SITE.author}</span>
          <span class="sep" aria-hidden="true">·</span>
          <span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          </span>
          <span class="sep" aria-hidden="true">·</span>
          <span>约 {minutes} 分钟阅读</span>
        </div>

        {
          updatedDate && (
            <p class="post__updated">
              最后更新于 {formatDate(updatedDate)}
            </p>
          )
        }

        {
          tags.length > 0 && (
            <div class="tag-list">
              {tags.map((tag) => (
                <a class="tag" href={withBase(`/tags/${encodeURIComponent(tag)}`)}>
                  {tag}
                </a>
              ))}
            </div>
          )
        }
      </header>

      {
        coverSrc && (
          <figure class="post__cover fade-in">
            <img src={coverSrc} alt={title} />
          </figure>
        )
      }

      <div class="prose post__content" id="post-content">
        <Content />
      </div>

        {
          toc.length > 2 && (
            <aside class="toc" aria-label="目录">
              <p class="toc__title">本文目录</p>
              <nav>
                <ul>
                  {toc.map((h) => (
                    <li class={`toc__item toc__item--h${h.depth}`}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
        </aside>
      )
      }

      <nav class="post-nav" aria-label="上一篇 / 下一篇">
        {
          prev ? (
            <a class="post-nav__link" href={withBase(`/posts/${prev.id}`)}>
              <span class="post-nav__dir">
                <Icon name="arrow-left" size={15} /> 上一篇
              </span>
              <span class="post-nav__title">{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a class="post-nav__link post-nav__link--next" href={withBase(`/posts/${next.id}`)}>
              <span class="post-nav__dir">
                下一篇 <Icon name="arrow-right" size={15} />
              </span>
              <span class="post-nav__title">{next.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </div>

  <button class="to-top" id="to-top" type="button" aria-label="回到顶部">
    <Icon name="chevron-up" size={20} />
  </button>
</BaseLayout>

<script>
  // 阅读进度条 + 回到顶部
  const bar = document.getElementById('progress-bar');
  const toTop = document.getElementById('to-top');

  const onScroll = () => {
    const doc = document.documentElement;
    const max = doc.scrollHeight - doc.clientHeight;
    const pct = max > 0 ? (doc.scrollTop / max) * 100 : 0;
    if (bar) bar.style.width = `${pct}%`;
    toTop?.classList.toggle('is-visible', doc.scrollTop > 600);
  };

  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  toTop?.addEventListener('click', () =>
    window.scrollTo({ top: 0, behavior: 'smooth' })
  );

  // 标题锚点
  document.querySelectorAll('#post-content :is(h2, h3, h4)').forEach((h) => {
    const id = h.getAttribute('id');
    if (!id) return;
    const a = document.createElement('a');
    a.className = 'anchor';
    a.href = `#${id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', '本节链接');
    h.appendChild(a);
  });

  // 目录高亮（scroll spy）
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'));
  const targets = links
    .map((a) => {
      const id = decodeURIComponent(a.getAttribute('href')?.slice(1) ?? '');
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => Boolean(el));

  if (targets.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const id = entry.target.id;
          links.forEach((a) =>
            a.classList.toggle(
              'is-active',
              decodeURIComponent(a.getAttribute('href')?.slice(1) ?? '') === id
            )
          );
        });
      },
      { rootMargin: '-88px 0px -70% 0px', threshold: 0 }
    );
    targets.forEach((t) => spy.observe(t));
  }
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 3px;
    z-index: 60;
    background: transparent;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background-image: linear-gradient(90deg, var(--accent), var(--accent-2), var(--accent-3));
    transition: width 0.1s linear;
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block: clamp(2rem, 6vw, 3.5rem) clamp(3rem, 8vw, 5rem);
  }

  /* 所有内容默认落在第一列 */
  .post > * {
    grid-column: 1;
    min-width: 0;
  }
  .post__header { grid-row: 1; }
  .post__cover { grid-row: 2; }
  .post__content { grid-row: 3; }
  .post-nav { grid-row: 4; }

  @media (min-width: 1080px) {
    .post:has(.toc) {
      grid-template-columns: minmax(0, 46rem) 15rem;
      justify-content: center;
      column-gap: clamp(2rem, 5vw, 3.5rem);
    }
  }

  .post__header {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    align-self: flex-start;
    font-size: 0.87rem;
    font-weight: 550;
    color: var(--text-muted);
    padding: 0.35rem 0.75rem 0.35rem 0.5rem;
    border-radius: var(--radius-full);
    transition: color 0.2s, background 0.2s, transform 0.3s var(--ease);
  }
  .back-link:hover {
    color: var(--accent);
    background: var(--accent-soft);
    transform: translateX(-3px);
  }

  .post__header h1 {
    font-size: clamp(1.95rem, 5.4vw, 3rem);
    line-height: 1.15;
    letter-spacing: -0.038em;
  }

  .post__desc {
    font-size: clamp(1rem, 1.9vw, 1.13rem);
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 52ch;
    padding-left: 1rem;
    border-left: 3px solid var(--border-strong);
  }

  .post__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-size: 0.87rem;
    color: var(--text-muted);
  }
  .post__author {
    font-weight: 600;
    color: var(--text-soft);
  }
  .sep {
    color: var(--text-faint);
  }
  .avatar {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    font-size: 0.78rem;
    font-weight: 700;
    color: #fff;
    background-image: linear-gradient(135deg, var(--accent), var(--accent-2));
    margin-right: -0.15rem;
  }
  :root[data-theme='dark'] .avatar {
    color: #0a0b0e;
  }

  .post__updated {
    font-size: 0.83rem;
    color: var(--text-faint);
  }

  .post__cover {
    margin: 0 0 2.75rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
  }
  .post__cover img {
    width: 100%;
    max-height: 30rem;
    object-fit: cover;
  }

  .toc {
    display: none;
    position: sticky;
    top: 6rem;
    align-self: start;
    max-height: calc(100vh - 8rem);
    overflow: auto;
    font-size: 0.86rem;
    padding-left: 1.1rem;
    border-left: 1px solid var(--border);
  }
  /* 用 .post > .toc 提升优先级，覆盖上面的 .post > * 定位 */
  @media (min-width: 1080px) {
    .post > .toc {
      display: block;
      grid-column: 2;
      grid-row: 3; /* 与正文首行对齐 */
      align-self: start;
    }
  }

  .toc__title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0.75rem;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .toc a {
    display: block;
    padding: 0.3rem 0;
    color: var(--text-muted);
    line-height: 1.45;
    border-left: 2px solid transparent;
    margin-left: -1.12rem;
    padding-left: 1rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }
  .toc__item--h3 a {
    padding-left: 1.7rem;
    font-size: 0.82rem;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .post-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition: border-color 0.25s, transform 0.35s var(--ease), background 0.25s;
  }
  .post-nav__link:hover {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--border));
    background: var(--surface-hover);
    transform: translateY(-2px);
  }
  .post-nav__link--next {
    text-align: right;
    align-items: flex-end;
  }
  .post-nav__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .post-nav__title {
    font-weight: 600;
    line-height: 1.45;
    color: var(--text);
  }

  .to-top {
    position: fixed;
    right: clamp(1rem, 4vw, 2rem);
    bottom: clamp(1rem, 4vw, 2rem);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 2.85rem;
    height: 2.85rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text-muted);
    box-shadow: var(--shadow);
    cursor: pointer;
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.3s, transform 0.35s var(--ease), color 0.2s,
      border-color 0.2s;
  }
  .to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .post-nav__link--next {
      text-align: left;
      align-items: flex-start;
    }
  }
</style>
